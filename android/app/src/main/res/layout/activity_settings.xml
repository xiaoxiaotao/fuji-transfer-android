<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/settings_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ui_background">
 <androidx.appcompat.widget.Toolbar android:id="@+id/ui_toolbar" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="56dp" app:titleTextColor="@color/ui_text" app:contentInsetStart="20dp" app:contentInsetEnd="16dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
 <ScrollView android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true" app:layout_constraintTop_toBottomOf="@id/ui_toolbar" app:layout_constraintBottom_toTopOf="@id/workbench_nav" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
  <TextView style="@style/UiBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="更改自动保存。下载选项用于下一次任务。" android:layout_marginBottom="16dp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/ui_card" android:padding="20dp" android:layout_marginBottom="12dp">
   <TextView style="@style/UiTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="下载与浏览" android:textSize="17sp"/>
   <androidx.appcompat.widget.SwitchCompat android:id="@+id/setting_skip" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="默认跳过已保存文件" android:textSize="14sp"/>
   <androidx.appcompat.widget.SwitchCompat android:id="@+id/setting_private" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="保存到应用目录" android:textSize="14sp"/>
   <TextView style="@style/UiBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="关闭：保存到系统相册或文件。开启：仅保存在本应用目录，卸载应用时会移除。" android:textSize="12sp"/>
   <androidx.appcompat.widget.SwitchCompat android:id="@+id/setting_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="图库显示文件详情" android:textSize="14sp"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/ui_card" android:padding="20dp">
   <TextView style="@style/UiTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="手机标识" android:textSize="17sp"/>
   <TextView style="@style/UiBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="显示在相机上的设备名称" android:layout_marginTop="6dp"/>
   <EditText android:id="@+id/client_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="8dp" android:inputType="textCapSentences" android:maxLines="1" android:textSize="16sp" android:hint="设备名称"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/ui_card" android:padding="20dp" android:layout_marginTop="12dp">
   <TextView style="@style/UiTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="直连 Wi-Fi 设置" android:textSize="17sp"/>
   <TextView style="@style/UiBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="用于手动连接相机热点。通常可使用默认地址。" android:layout_marginTop="6dp"/>
   <TextView style="@style/UiBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="相机 IP 地址" android:layout_marginTop="20dp"/>
   <EditText android:id="@+id/ip_address_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textUri" android:maxLines="1" android:textSize="16sp" android:hint="192.168.0.1"/>
   <TextView style="@style/UiBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Wi-Fi 密码" android:layout_marginTop="16dp"/>
   <EditText android:id="@+id/wpa_password" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textPassword" android:maxLines="1" android:textSize="16sp" android:hint="无密码时留空"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/ui_card" android:padding="20dp" android:layout_marginTop="12dp">
   <TextView style="@style/UiTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="存储与帮助" android:textSize="17sp"/>
   <Button android:id="@+id/settings_clear_cache" style="@style/UiTextButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="清理缩略图缓存"/>
   <TextView style="@style/UiBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="只清理预览缓存，已保存的原文件继续保留。" android:textSize="12sp"/>
   <Button android:id="@+id/settings_help" style="@style/UiTextButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="连接与使用帮助"/>
   <Button android:id="@+id/settings_diagnostic" style="@style/UiTextButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="查看与复制诊断"/>
  </LinearLayout>
  <TextView style="@style/UiTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="局域网" android:textSize="17sp" android:layout_marginTop="24dp"/>
  <TextView style="@style/UiBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="搜索支持电脑自动保存或无线联机拍摄的相机。" android:layout_marginTop="8dp"/>
  <Button android:id="@+id/start_discovery" style="@style/GreyButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:text="开始局域网搜索"/>
 </LinearLayout>
 </ScrollView>
<include layout="@layout/workbench_nav" android:id="@+id/workbench_nav" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/></androidx.constraintlayout.widget.ConstraintLayout>
