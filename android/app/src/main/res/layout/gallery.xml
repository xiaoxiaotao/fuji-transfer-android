<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/gallery_main_view" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ui_background">
 <androidx.appcompat.widget.Toolbar android:id="@+id/ui_toolbar" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="56dp" android:background="@color/ui_background" app:titleTextColor="@color/ui_text" app:subtitleTextColor="@color/ui_muted" app:contentInsetStart="20dp" app:contentInsetEnd="16dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
 <LinearLayout android:id="@+id/gallerymenu" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/ui_toolbar" android:paddingTop="4dp" android:paddingBottom="12dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
   <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="相机照片" android:visibility="gone" android:textSize="20sp" android:textColor="@color/ui_text" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="正在读取照片…" android:textSize="14sp" android:textColor="@color/ui_muted" android:id="@+id/gallery_count" android:layout_marginTop="4dp" />
   </LinearLayout>
   <Button android:id="@+id/import_button" android:layout_width="72dp" android:layout_height="48dp" android:text="选择" style="@style/UiTextButton" />
  </LinearLayout>
  <TextView android:id="@+id/camera_status" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:gravity="center_vertical" android:layout_marginTop="8dp" android:paddingHorizontal="12dp" android:paddingVertical="8dp" android:text="正在建立相机会话…" android:textColor="@color/ui_muted" android:textSize="12sp" android:background="@drawable/light_button" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:maxLines="1" android:ellipsize="end" />
  <dev.danielc.fujiapp.ConnectionStatusView android:id="@+id/connection_status_panel" android:tag="gallery" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
  <LinearLayout android:id="@+id/selection_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone">
   <Button android:id="@+id/select_all" android:layout_width="0dp" android:layout_height="48dp" android:text="全选当前" android:layout_weight="1" android:layout_marginEnd="8dp" style="@style/GreyButton" android:textSize="13sp" />
   <Button android:id="@+id/clear_selection" android:layout_width="0dp" android:layout_height="48dp" android:text="清空" android:layout_weight="1" style="@style/GreyButton" android:textSize="13sp" />
     <Button android:id="@+id/range_photos" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="范围选择" style="@style/GreyButton" android:textSize="13sp" /></LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
   <Button android:id="@+id/gallery_button" android:layout_width="0dp" android:layout_height="48dp" android:text="视图 ▾" android:layout_weight="1" android:layout_marginEnd="8dp" style="@style/UiTextButton" android:textSize="13sp" />
   <Button android:id="@+id/filter_photos" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="筛选与排序" style="@style/UiTextButton" android:textSize="13sp" />

   <Button android:id="@+id/table_button" android:layout_width="0dp" android:layout_height="52dp" android:text="文件列表" android:visibility="gone" android:layout_weight="1" style="@style/GreyButton" />
  </LinearLayout>
<HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:layout_marginTop="8dp"><LinearLayout android:id="@+id/gallery_chips" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content"/></HorizontalScrollView> </LinearLayout>
 <FrameLayout android:id="@+id/fileView" android:layout_width="0dp" android:layout_height="0dp" android:paddingHorizontal="12dp" app:layout_constraintTop_toBottomOf="@id/gallerymenu" app:layout_constraintBottom_toTopOf="@id/transfer_panel" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" ><TextView android:id="@+id/gallery_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="24dp" android:text="正在准备相机照片…" android:textColor="@color/ui_muted" android:textSize="14sp"/></FrameLayout>
 <LinearLayout android:id="@+id/transfer_panel" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/ui_panel" app:layout_constraintBottom_toTopOf="@id/workbench_nav" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginLeft="12dp" android:layout_marginRight="12dp" android:layout_marginBottom="8dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
   <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="长按照片进入多选" android:textSize="12sp" android:textColor="@color/ui_muted" android:id="@+id/transfer_caption" android:maxLines="3" android:layout_weight="1" />
   <Button style="@style/UiTextButton" android:id="@+id/download_tasks" android:layout_width="72dp" android:layout_height="48dp" android:text="任务" />
  </LinearLayout>
  <ProgressBar android:id="@+id/transfer_progress" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="12dp" android:max="100" android:visibility="gone" style="?android:attr/progressBarStyleHorizontal" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:id="@+id/download_actions">
   <Button android:id="@+id/download_selected" android:layout_width="0dp" android:layout_height="48dp" android:text="下载 0 张" android:layout_weight="1" style="@style/GoButton" />
   <Button android:id="@+id/cancel_transfer" android:layout_width="72dp" android:layout_height="48dp" android:text="停止" android:layout_marginStart="8dp" android:visibility="gone" style="@style/GreyButton" />
  </LinearLayout>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="10sp" android:textColor="@color/ui_text" android:id="@+id/gallery_logs" android:maxLines="1" android:ellipsize="start" android:layout_marginTop="8dp" android:visibility="gone" />
 </LinearLayout>
<include layout="@layout/workbench_nav" android:id="@+id/workbench_nav" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/></androidx.constraintlayout.widget.ConstraintLayout>
